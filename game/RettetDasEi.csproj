<Project Sdk="Godot.NET.Sdk/4.6.2">

  <!--
    The Godot side: physics, the hand, the view (ADR 001). The rules live in ../sim and are
    referenced here (ADR 002).
    The Sdk version MUST match your Godot editor version exactly (see SETUP.md).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>RettetDasEi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../sim/RettetDasEi.Sim/RettetDasEi.Sim.csproj" />
  </ItemGroup>

</Project>
