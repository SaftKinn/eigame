<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The rules core (ADR 002). Pure C#, NO Godot reference: Godot reports what touches what,
    this library decides what follows. Everything here compiles and is tested with `dotnet test`.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>RettetDasEi.Sim</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Godot builds the game with Configuration=ExportRelease and passes it down to this reference. -->
  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RettetDasEi.Sim.Tests" />
  </ItemGroup>

</Project>
